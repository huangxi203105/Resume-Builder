JWT_SECRET = "MTJ"
# # 数据库配置
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# # JWT 密钥
# JWT_SECRET=your_jwt_secret_key_here

# # 服务器端口
# PORT=4000

# # 腾讯云 COS 配置
# # 获取方式：腾讯云控制台 -> 访问管理 -> 访问密钥 -> API密钥管理
# TENCENT_SECRET_ID=your_secret_id_here
# TENCENT_SECRET_KEY=your_secret_key_here

# # COS 存储桶配置
# # 获取方式：腾讯云控制台 -> 对象存储 COS -> 存储桶列表
# TENCENT_COS_REGION=ap-beijing
# TENCENT_COS_BUCKET=your-bucket-name-1234567890

# # 注意事项：
# # 1. 请将此文件复制为 .env 并填入真实配置
# # 2. 不要将 .env 文件提交到版本控制系统
# # 3. 存储桶名称必须全局唯一
# # 4. 地域代码参考：https://cloud.tencent.com/document/product/436/6224
